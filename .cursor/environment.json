{
  "name": "SIG Stakeholder Database",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start-mariadb.sh",
  "terminals": [
    {
      "name": "php-server",
      "command": "php -S 0.0.0.0:8080 -t ."
    }
  ],
  "ports": [
    { "port": 8080 }
  ]
}
